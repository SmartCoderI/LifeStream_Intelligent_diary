# Copy to .env and fill in. .env is git-ignored.

# Hugging Face read token. First accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Claude API key (classification + summaries)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# WHISPER_MODEL=medium.en     # cloud GPU: large-v3
# DEVICE=cpu                  # cloud GPU: cuda
# COMPUTE_TYPE=int8           # cloud GPU: float16
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# MAX_KEYFRAMES=20

# Stage 2 memory (defaults shown; the database runs in Docker: docker compose up -d db)
# DATABASE_URL=postgresql://lifestream:lifestream@localhost:5433/lifestream
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# SPEAKERS_FILE=data/speakers.yaml
