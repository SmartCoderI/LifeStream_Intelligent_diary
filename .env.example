# Copy to .env and fill in. .env is git-ignored.

# Hugging Face read token. First accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Which LLM writes classifications, summaries and answers. Only claude is enabled;
# Qwen is commented out in src/lifestream/intelligence/llm.py (make_llm).
LLM_PROVIDER=claude

# --- Qwen (disabled) ---
# Qwen API key (Alibaba Cloud Model Studio / DashScope). Not needed for a local Ollama server.
# QWEN_API_KEY=
# QWEN_MODEL=qwen3-vl-plus    # must be a vision (VL) model: keyframes are sent with the transcript
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   China region:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   Local Ollama:  http://localhost:11434/v1   (with e.g. QWEN_MODEL=qwen2.5vl:7b)
#   OpenRouter:    https://openrouter.ai/api/v1 (QWEN_API_KEY = your OpenRouter key)
# QWEN_MAX_TOKENS=8192        # cap on reply length; raise if summaries get cut off
# QWEN_JSON_MODE=true         # set false if your server rejects response_format

# --- Claude (active) ---
# Claude API key
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# WHISPER_MODEL=medium.en     # cloud GPU: large-v3-turbo (or large-v3; terraform var whisper_model)
# DEVICE=cpu                  # cloud GPU: cuda
# COMPUTE_TYPE=int8           # cloud GPU: float16
# ASR_BATCH_SIZE=8            # cloud GPU: 16 (terraform var asr_batch_size)
# PARALLEL_AUDIO=auto         # diarization alongside transcription; auto = when both run on a GPU
# SCENE_SAMPLE_FPS=5          # frames per second compared for scene cuts (0 = every frame)
# LLM_MODEL=claude-opus-5-5   # Claude only
# LLM_EFFORT=medium           # Claude only
# MAX_KEYFRAMES=20

# Stage 2 memory (defaults shown; the database runs in Docker: docker compose up -d db)
# DATABASE_URL=postgresql://lifestream:lifestream@localhost:5433/lifestream
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# SPEAKERS_FILE=data/speakers.yaml
